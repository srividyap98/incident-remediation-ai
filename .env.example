# ─── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default

# ─── Bedrock ─────────────────────────────────────────────────────────────────
BEDROCK_LLM_MODEL_ID=anthropic.claude-sonnet-4-5
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ─── Vector Store ────────────────────────────────────────────────────────────
VECTOR_STORE_BACKEND=faiss               # faiss | qdrant | opensearch
FAISS_INDEX_PATH=./data/faiss_index
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=incident_knowledge
QDRANT_API_KEY=

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=incident-remediation

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_CORS_ORIGINS=["http://localhost:3000"]

# ─── Agent Tuning ────────────────────────────────────────────────────────────
RETRIEVER_TOP_K=5
RISK_SCORE_THRESHOLD=0.7
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ─── Observability — OTel ────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── Observability — Splunk ──────────────────────────────────────────────────
# SPLUNK_HEC_URL=https://your-splunk.example.com:8088
# SPLUNK_HEC_TOKEN=your-hec-token

# ─── Observability — Honeycomb ───────────────────────────────────────────────
# HONEYCOMB_API_KEY=your-honeycomb-api-key
# (Set OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io when using Honeycomb)

# ─── Observability — Arize ───────────────────────────────────────────────────
# ARIZE_API_KEY=your-arize-api-key
# ARIZE_SPACE_ID=your-arize-space-id

# ─── Dev / Offline Mode ──────────────────────────────────────────────────────
# Set to true to run with zero AWS calls (local mocks + sentence-transformers)
OFFLINE_MODE=false

# ─── Auth ────────────────────────────────────────────────────────────────────
# JSON map of API key -> caller identity, sent via the X-API-Key header.
# Leave empty to disable auth entirely (local/offline dev — the default).
# Example: API_KEYS={"sk-live-abc123":"jsmith","sk-live-def456":"asingh"}
API_KEYS={}
